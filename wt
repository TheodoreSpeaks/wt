#!/bin/bash
set -e

# Usage: ./wt <repo-name> <branch-name> [--rm]
#        ./wt ls [repo-name]
#        ./wt gh check

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
YAML_FILE="$SCRIPT_DIR/wt-config.yaml"
SHARED_SCRIPTS_DIR="$SCRIPT_DIR/shared-scripts"

# Symlink every executable in shared-scripts/ into the given worktree, and add
# the script names to the worktree's local git exclude so they don't show up as
# untracked files.
sync_shared_scripts_into() {
    local worktree="$1"
    [ -d "$SHARED_SCRIPTS_DIR" ] || return 0
    # Worktrees share the main repo's .git/info/exclude (the "common" git dir),
    # not the per-worktree one — so write exclusions there.
    local common_dir
    common_dir=$(git -C "$worktree" rev-parse --git-common-dir 2>/dev/null) || return 0
    case "$common_dir" in
        /*) ;;
        *) common_dir="$worktree/$common_dir" ;;
    esac
    local exclude_file="$common_dir/info/exclude"
    mkdir -p "$(dirname "$exclude_file")"
    touch "$exclude_file"
    for script in "$SHARED_SCRIPTS_DIR"/*; do
        [ -f "$script" ] && [ -x "$script" ] || continue
        local name
        name=$(basename "$script")
        local dest="$worktree/$name"
        rm -f "$dest"
        ln -s "$script" "$dest"
        grep -qxF "/$name" "$exclude_file" || echo "/$name" >> "$exclude_file"
    done
}

# Apply wt-config.yaml `mappings:` for the given worktree's repo.
# Sources prefixed with `env/` are workspace-relative; others are relative to
# the canonical repo (e.g. .turbo caches). Optional mappings are silent if
# missing.
sync_env_mappings_into() {
    local worktree="$1"
    [ -f "$YAML_FILE" ] || return 0
    command -v yq >/dev/null || return 0

    local rel repo_name
    case "$worktree" in
        "$SCRIPT_DIR"/*-wt/*)
            rel="${worktree#"$SCRIPT_DIR"/}"
            repo_name="${rel%%-wt/*}"
            ;;
        "$SCRIPT_DIR"/*)
            rel="${worktree#"$SCRIPT_DIR"/}"
            repo_name="${rel%%/*}"
            ;;
        *) return 0 ;;
    esac
    [ -d "$SCRIPT_DIR/$repo_name/.git" ] || return 0
    local repo_path="$SCRIPT_DIR/$repo_name"

    while IFS='|' read -r src dst opt; do
        [ -n "$src" ] && [ -n "$dst" ] || continue
        local source_path
        if [[ "$src" == env/* ]]; then
            source_path="$SCRIPT_DIR/$src"
        else
            source_path="$repo_path/$src"
        fi
        local dest_path="$worktree/$dst"
        if [ -e "$source_path" ]; then
            mkdir -p "$(dirname "$dest_path")"
            rm -rf "$dest_path"
            ln -s "$source_path" "$dest_path"
            echo "  Linked: $src -> $dst"
        elif [ "$opt" != "true" ]; then
            echo "  Warning: source not found: $source_path"
        fi
    done < <(yq -r ".mappings[] | select(.repo == \"$repo_name\") | .source + \"|\" + .dest + \"|\" + ((.optional // false) | tostring)" "$YAML_FILE")
}

show_usage() {
    echo "Usage: ./wt <repo-name> <branch-name>        # Create worktree"
    echo "       ./wt <repo-name> <branch-name> --rm   # Remove worktree"
    echo "       ./wt ls                               # List all worktrees"
    echo "       ./wt ls <repo-name>                   # List worktrees for repo"
    echo "       ./wt gh check                         # Check PRs for new comments"
    echo "       ./wt sync                             # Re-sync shared-scripts/* AND env mappings into every canonical + worktree"
    echo ""
    echo "<repo-name> is any repo registered in wt-config.yaml — list with"
    echo "  yq -r '.repos | keys | .[]' wt-config.yaml"
    echo ""
    echo "Examples (substitute any registered repo):"
    echo "  ./wt <repo> feature/my-branch"
    echo "  ./wt <repo> feature/my-branch --rm"
    echo "  ./wt ls"
    exit 1
}

# Re-sync shared-scripts/* AND wt-config.yaml mappings into every canonical + worktree.
# (Backwards-compat alias: `sync-scripts` still works.)
if [ "$1" = "sync" ] || [ "$1" = "sync-scripts" ]; then
    [ -d "$SHARED_SCRIPTS_DIR" ] || { echo "no shared-scripts/ dir at $SHARED_SCRIPTS_DIR"; exit 1; }
    for repo_dir in "$SCRIPT_DIR"/*/; do
        [ -d "$repo_dir/.git" ] || continue
        # Walk every worktree (`git worktree list` includes the canonical repo
        # as one of them; we sync into all so ./run / ./kill / ./rm work
        # identically inside canonicals and worktrees alike).
        while IFS= read -r line; do
            wtp=$(echo "$line" | awk '{print $1}')
            [ -d "$wtp" ] || continue
            echo "→ $wtp"
            sync_shared_scripts_into "$wtp"
            sync_env_mappings_into "$wtp"
        done < <(git -C "$repo_dir" worktree list)
    done
    exit 0
fi

# GitHub comment check command
if [ "$1" = "gh" ] && [ "$2" = "check" ]; then
    SEEN_FILE="$SCRIPT_DIR/.gh-check-seen"
    touch "$SEEN_FILE"
    MY_LOGIN=$(gh api user --jq .login)
    BOTS="vercel cursor dependabot github-actions"
    found_any=false

    for repo_dir in "$SCRIPT_DIR"/*/; do
        [ -d "$repo_dir/.git" ] || continue
        repo_name=$(basename "$repo_dir")
        cd "$repo_dir"
        repo_full=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null) || continue

        # Get open/draft PRs authored by me
        prs=$(gh pr list --author "$MY_LOGIN" --state open --json number,title,headRefName,url,comments,reviews 2>/dev/null) || continue

        echo "$prs" | jq -c '.[]' | while IFS= read -r pr; do
            pr_number=$(echo "$pr" | jq -r '.number')
            pr_title=$(echo "$pr" | jq -r '.title')
            branch=$(echo "$pr" | jq -r '.headRefName')
            pr_url=$(echo "$pr" | jq -r '.url')

            # Collect new comments (issue comments + review comments)
            new_comments=()

            # Issue comments
            while IFS= read -r comment; do
                [ -z "$comment" ] && continue
                comment_id=$(echo "$comment" | jq -r '.id')
                author=$(echo "$comment" | jq -r '.author')
                body=$(echo "$comment" | jq -r '.body')

                # Skip self and bots
                [ "$author" = "$MY_LOGIN" ] && continue
                is_bot=false
                for bot in $BOTS; do
                    [[ "$author" == *"$bot"* ]] && is_bot=true && break
                done
                $is_bot && continue

                # Skip if seen
                grep -qF "$comment_id" "$SEEN_FILE" && continue

                new_comments+=("$comment_id|$author|$body")
            done < <(echo "$pr" | jq -c '.comments[] | {id: .id, author: .author.login, body: .body}')

            # Review comments (inline code reviews)
            while IFS= read -r review; do
                [ -z "$review" ] && continue
                review_id=$(echo "$review" | jq -r '.id')
                author=$(echo "$review" | jq -r '.author')
                body=$(echo "$review" | jq -r '.body')

                [ "$author" = "$MY_LOGIN" ] && continue
                [ -z "$body" ] || [ "$body" = "null" ] || [ "$body" = "" ] && continue
                is_bot=false
                for bot in $BOTS; do
                    [[ "$author" == *"$bot"* ]] && is_bot=true && break
                done
                $is_bot && continue

                grep -qF "$review_id" "$SEEN_FILE" && continue

                new_comments+=("$review_id|$author|$body")
            done < <(echo "$pr" | jq -c '.reviews[] | {id: .id, author: .author.login, body: .body}')

            # Also fetch review thread comments (inline code comments)
            review_comments=$(gh api "repos/$repo_full/pulls/$pr_number/comments" --jq '.[] | {id: .id, author: .user.login, body: .body, path: .path, line: .line}' 2>/dev/null) || true
            while IFS= read -r rc; do
                [ -z "$rc" ] && continue
                rc_id=$(echo "$rc" | jq -r '.id')
                author=$(echo "$rc" | jq -r '.author')
                body=$(echo "$rc" | jq -r '.body')
                path=$(echo "$rc" | jq -r '.path')
                line=$(echo "$rc" | jq -r '.line')

                [ "$author" = "$MY_LOGIN" ] && continue
                is_bot=false
                for bot in $BOTS; do
                    [[ "$author" == *"$bot"* ]] && is_bot=true && break
                done
                $is_bot && continue

                grep -qF "$rc_id" "$SEEN_FILE" && continue

                if [ "$path" != "null" ] && [ -n "$path" ]; then
                    new_comments+=("$rc_id|$author|[$path:$line] $body")
                else
                    new_comments+=("$rc_id|$author|$body")
                fi
            done < <(echo "$review_comments" | jq -c '.' 2>/dev/null)

            # Show new comments
            for entry in "${new_comments[@]}"; do
                found_any=true
                comment_id="${entry%%|*}"
                rest="${entry#*|}"
                author="${rest%%|*}"
                body="${rest#*|}"

                echo ""
                echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                echo "📌 $repo_name #$pr_number: $pr_title"
                echo "   Branch: $branch"
                echo "   From: $author"
                echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                echo "$body" | head -30
                echo ""

                read -rp "Send to Claude in tmux window '$branch'? (y/n) " answer
                echo "$comment_id" >> "$SEEN_FILE"

                if [[ "$answer" =~ ^[yY](es)?$ ]]; then
                    if [ -n "$TMUX" ]; then
                        # Find the window with this branch name and send to pane 0
                        if tmux select-window -t "$branch" 2>/dev/null; then
                            escaped_body=$(printf '%s' "$body" | sed "s/'/'\\\\''/g")
                            tmux send-keys -t "$branch.0" "PR comment from $author on $repo_name#$pr_number: $escaped_body" Enter
                            tmux select-window -t "$branch" 2>/dev/null
                            echo "✓ Sent to Claude"
                        else
                            echo "⚠ No tmux window found for '$branch'"
                        fi
                    else
                        echo "⚠ Not in a tmux session"
                    fi
                fi
            done
        done
    done

    if [ "$found_any" = false ]; then
        echo "No new comments found."
    fi
    exit 0
fi

# List worktrees command
if [ "$1" = "ls" ]; then
    print_worktrees() {
        local repo_name="$1"
        local repo_path="$2"
        local is_last_repo="$3"

        if [ "$is_last_repo" = "true" ]; then
            echo "└── $repo_name"
            prefix="    "
        else
            echo "├── $repo_name"
            prefix="│   "
        fi

        cd "$repo_path"
        local worktrees=()
        while IFS= read -r line; do
            worktrees+=("$line")
        done < <(git worktree list)

        local count=${#worktrees[@]}
        local i=0
        for wt in "${worktrees[@]}"; do
            i=$((i + 1))
            # Parse worktree line: /path/to/worktree  abc1234 [branch]
            local wt_path=$(echo "$wt" | awk '{print $1}')
            local wt_branch=$(echo "$wt" | grep -o '\[.*\]' | tr -d '[]')
            local wt_name=$(basename "$wt_path")

            if [ $i -eq $count ]; then
                echo "${prefix}└── $wt_name ($wt_branch)"
            else
                echo "${prefix}├── $wt_name ($wt_branch)"
            fi
        done
    }

    if [ -n "$2" ]; then
        # List worktrees for specific repo
        REPO_NAME="$2"
        REPO_PATH="$SCRIPT_DIR/$REPO_NAME"
        if [ ! -d "$REPO_PATH/.git" ]; then
            echo "Error: Repository '$REPO_NAME' not found at $REPO_PATH"
            exit 1
        fi
        echo "worktrees"
        print_worktrees "$REPO_NAME" "$REPO_PATH" "true"
    else
        # List worktrees for all repos
        echo "worktrees"
        repos=()
        for repo_dir in "$SCRIPT_DIR"/*/; do
            if [ -d "$repo_dir/.git" ]; then
                repos+=("$repo_dir")
            fi
        done

        count=${#repos[@]}
        i=0
        for repo_dir in "${repos[@]}"; do
            i=$((i + 1))
            repo_name=$(basename "$repo_dir")
            if [ $i -eq $count ]; then
                print_worktrees "$repo_name" "$repo_dir" "true"
            else
                print_worktrees "$repo_name" "$repo_dir" "false"
            fi
        done
    fi
    exit 0
fi

if [ $# -lt 2 ]; then
    show_usage
fi

REPO_NAME="$1"
BRANCH_NAME="$2"
REMOVE_FLAG=""

# Check for --rm flag
if [ "$3" = "--rm" ]; then
    REMOVE_FLAG="true"
fi

REPO_PATH="$SCRIPT_DIR/$REPO_NAME"

# Sanitize branch name for directory (replace / with -)
WORKTREE_DIR_NAME="${BRANCH_NAME//\//-}"
WORKTREE_PARENT="$SCRIPT_DIR/$REPO_NAME-wt"
WORKTREE_PATH="$WORKTREE_PARENT/$WORKTREE_DIR_NAME"

if [ ! -d "$REPO_PATH/.git" ]; then
    echo "Error: Repository '$REPO_NAME' not found at $REPO_PATH"
    exit 1
fi

# Handle remove
if [ "$REMOVE_FLAG" = "true" ]; then
    if [ ! -d "$WORKTREE_PATH" ]; then
        echo "Error: Worktree not found at $WORKTREE_PATH"
        exit 1
    fi

    echo "Removing worktree for $REPO_NAME at branch $BRANCH_NAME..."

    # Order matters: do the disk work BEFORE killing the tmux window. When
    # `./rm` is invoked from inside the worktree's own window, kill-window
    # SIGHUPs the running script — anything after it never runs.
    cd "$REPO_PATH"
    git worktree remove "$WORKTREE_PATH" --force
    echo "Worktree removed at $WORKTREE_PATH."

    if [ -n "$TMUX" ]; then
        tmux kill-window -t "$BRANCH_NAME" 2>/dev/null || true
    fi
    exit 0
fi

# If worktree already exists, just open it
if [ -d "$WORKTREE_PATH" ]; then
    echo "Worktree already exists at: $WORKTREE_PATH"

    if [ -n "$TMUX" ]; then
        echo "Opening in tmux..."
        tmux new-window -n "$BRANCH_NAME" -c "$WORKTREE_PATH"
        tmux split-window -h -c "$WORKTREE_PATH"
        setup_cmd=$(yq -r ".repos.\"$REPO_NAME\".setup // \"\"" "$YAML_FILE" 2>/dev/null)
        if [ -n "$setup_cmd" ] && [ "$setup_cmd" != "null" ]; then
            tmux send-keys "$setup_cmd" Enter
        fi

        # Select left pane and run claude
        tmux select-pane -t 0
        tmux send-keys "claude" Enter
    fi
    exit 0
fi

# Create worktree parent directory if it doesn't exist
mkdir -p "$WORKTREE_PARENT"

# Check if yaml file exists
if [ ! -f "$YAML_FILE" ]; then
    echo "Error: wt-config.yaml not found at $YAML_FILE"
    exit 1
fi

echo "Creating worktree for $REPO_NAME at branch $BRANCH_NAME..."

# Navigate to the repo
cd "$REPO_PATH"

# Fetch latest
git fetch origin

# Check if branch exists on remote
if git ls-remote --heads origin "$BRANCH_NAME" | grep -q "$BRANCH_NAME"; then
    echo "Branch '$BRANCH_NAME' exists on remote, checking out..."
    git worktree add "$WORKTREE_PATH" "$BRANCH_NAME"
else
    echo "Branch '$BRANCH_NAME' does not exist, creating from current HEAD..."
    git worktree add -b "$BRANCH_NAME" "$WORKTREE_PATH"
fi

# Set upstream tracking (without pushing — remote branch is created on first push)
cd "$WORKTREE_PATH"
git config "branch.$BRANCH_NAME.remote" origin
git config "branch.$BRANCH_NAME.merge" "refs/heads/$BRANCH_NAME"

echo "Worktree created at: $WORKTREE_PATH"

# Apply env/cache symlinks from wt-config.yaml mappings.
echo "Setting up symlinks..."
sync_env_mappings_into "$WORKTREE_PATH"

# Symlink .claude/settings.local.json from main repo so permissions are shared
CLAUDE_SETTINGS_SOURCE="$REPO_PATH/.claude/settings.local.json"
CLAUDE_SETTINGS_DEST="$WORKTREE_PATH/.claude/settings.local.json"
if [ -f "$CLAUDE_SETTINGS_SOURCE" ]; then
    mkdir -p "$WORKTREE_PATH/.claude"
    rm -f "$CLAUDE_SETTINGS_DEST"
    ln -s "$CLAUDE_SETTINGS_SOURCE" "$CLAUDE_SETTINGS_DEST"
    echo "  Linked: .claude/settings.local.json (shared permissions)"
fi

# Symlink shared workspace scripts (run / kill / rm / …) into the worktree
sync_shared_scripts_into "$WORKTREE_PATH"
echo "  Linked: shared-scripts/* -> ./"

echo ""
echo "Done! Worktree ready at: $WORKTREE_PATH"

# If inside tmux, create new window with split layout
if [ -n "$TMUX" ]; then
    echo "Opening in tmux..."

    # Create new window named after branch, cd to worktree
    tmux new-window -n "$BRANCH_NAME" -c "$WORKTREE_PATH"

    # Split vertically (side by side)
    tmux split-window -h -c "$WORKTREE_PATH"

    # Per-repo setup hook (e.g. bun install, cargo build, go mod download).
    setup_cmd=$(yq -r ".repos.\"$REPO_NAME\".setup // \"\"" "$YAML_FILE" 2>/dev/null)
    if [ -n "$setup_cmd" ] && [ "$setup_cmd" != "null" ]; then
        tmux send-keys "$setup_cmd" Enter
    fi

    # Select left pane and run claude
    tmux select-pane -t 0
    tmux send-keys "claude" Enter
fi
